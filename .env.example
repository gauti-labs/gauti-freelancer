# ─────────────────────────────────────────────────────────────
# GAUTAM GOYAL — DIGITAL ARCHITECT
# Environment configuration. Copy to .env.local for local dev.
# Never commit .env or .env.local.
# ─────────────────────────────────────────────────────────────

# Public site URL. No trailing slash.
# Local:  http://localhost:3000
# Prod:   https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── MongoDB Atlas ─────────────────────────────────────────────
# Create a free M0 cluster at https://cloud.mongodb.com
# Whitelist 0.0.0.0/0 for local dev (or your IP), and Vercel IPs for prod.
MONGODB_URI=
MONGODB_DB=gautam_goyal

# ── Auth.js v5 ────────────────────────────────────────────────
# Generate with:  openssl rand -base64 32
AUTH_SECRET=
# Trust the host in preview / prod. Auth.js reads this automatically on Vercel.
AUTH_TRUST_HOST=true

# ── Google OAuth ──────────────────────────────────────────────
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://your-domain.com/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── Resend (magic-link email + project inquiry notifications) ─
# https://resend.com/api-keys
AUTH_RESEND_KEY=
# Verified sender in Resend. During local dev you may use "onboarding@resend.dev".
EMAIL_FROM="Gautam Goyal <onboarding@resend.dev>"

# Where project-inquiry notifications are sent.
NOTIFY_EMAIL=gautamgoyal1996@gmail.com

# ── Admin authorisation ───────────────────────────────────────
# Comma-separated allowlist. These emails receive the /admin panel.
ADMIN_EMAILS=gautamgoyal1996@gmail.com

# ── Private contact (authenticated-only phone reveal) ─────────
# Format: full international, e.g. +91XXXXXXXXXX. Leave blank to hide the CTA.
ADMIN_PHONE=

# ── Google Gemini (server-side only) ──────────────────────────
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Optional: model override. Defaults to gemini-2.0-flash.
GEMINI_MODEL=gemini-2.0-flash

# ── Groq (public chatbot primary provider) ─────────────────────
# https://console.groq.com/keys
GROQ_API_KEY=
# Optional: model override. Defaults to qwen/qwen3.8-27b.
GROQ_MODEL=qwen/qwen3.8-27b

# ── Optional: search-console verification ─────────────────────
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
